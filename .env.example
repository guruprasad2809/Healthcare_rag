# Copy this file to `.env` and fill in the blanks.  Never commit `.env`.

# ---------------- LLM (Gemini) ----------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini 4 Hydrogen has no public model ID yet. Put its ID here when Google releases it.
GEMINI_MODEL=gemini-3.8-flash

# ---------------- Hugging Face ----------------
# Optional. Only needed if model downloads are rate-limited.
HF_TOKEN=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Leave empty to auto-detect (cuda > mps > cpu)
DEVICE=

# ---------------- Qdrant ----------------
# Leave QDRANT_URL empty to use embedded local storage (./qdrant_storage).
# Docker: http://localhost:6333      Qdrant Cloud: https://<cluster-id>.cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=healthcare_docs

# ---------------- Chunking ----------------
CHUNK_MAX_TOKENS=350
CHUNK_MIN_TOKENS=60
CHUNK_SEMANTIC_SPLIT=true

# ---------------- Retrieval ----------------
DENSE_TOP_K=30
BM25_TOP_K=30
FUSION_TOP_K=30
FINAL_TOP_K=5
MIN_RERANK_SCORE=0.01

# ---------------- App ----------------
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_MB=25
